# ============================================================
# smart-kb-agent 环境变量模板
# 复制为 .env 后按需修改；JWT_SECRET 必须填写（见文末说明）
# ============================================================

# ---- LLM（OpenAI 兼容，默认 DeepSeek） ----
LLM_PROVIDER=openai
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=1024

# ---- Embedding（本地 sentence-transformers 为默认） ----
# sentence-transformers | openai | hash（hash 仅用于离线测试）
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 使用 openai 兼容 embedding 服务时才需要：
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# 本地模型已缓存时自动切离线加载，避免每次启动往返 HuggingFace
# 若希望强制在线校验可设为 false
HF_OFFLINE_AUTO=true

# ---- 向量库 ----
# chroma | memory（memory 仅用于离线测试）
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_kb

# ---- 鉴权 ----
# 必填！留空或保持占位值（change-me 等）时服务会拒绝启动。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
# start.bat 首次生成 .env 时会自动写入一个随机值。
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# 登录/注册每 IP 每分钟允许的请求数（防暴力破解与 CPU 放大攻击）
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- 切分与检索 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
RERANK_TOP_K=3
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
MAX_HISTORY_MESSAGES=6

# ---- 请求边界（防成本/内存放大） ----
MAX_QUESTION_CHARS=2000
MAX_TOP_K=20
MAX_UPLOAD_MB=20

# ---- Router ----
# 规则判不出时是否调用 LLM 分类（默认 false：少一次 LLM 调用，直接兜底 RAG）
ROUTER_ENABLE_LLM=false

# ---- Agent ----
AGENT_MAX_ITERATIONS=5
