# ============================================================
# smart-kb-agent 环境变量模板
# 复制为 .env 后按需修改；JWT_SECRET 必须填写（见文末说明）
# ============================================================

# ---- LLM（OpenAI 兼容，默认 DeepSeek） ----
LLM_PROVIDER=openai
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash
# 生成上限。注意：推理类模型会先输出 reasoning_content 再输出 content，
# 预算给小了（如 1024）会出现 content 为空、finish_reason=length，看起来像"模型返回空"。
# 客户端遇到这种情况会自动加倍预算重试，但建议这里直接给足（默认 4096）。
LLM_MAX_TOKENS=4096

# ---- Embedding（本地 sentence-transformers 为默认） ----
# sentence-transformers | openai | hash（hash 仅用于离线测试）
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 使用 openai 兼容 embedding 服务时才需要：
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# 本地模型已缓存时自动切离线加载，避免每次启动往返 HuggingFace
# 若希望强制在线校验可设为 false
HF_OFFLINE_AUTO=true

# ---- 向量库 ----
# chroma | memory（memory 仅用于离线测试）
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_kb

# ---- 鉴权 ----
# 必填！留空或保持占位值（change-me 等）时服务会拒绝启动。
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
# start.bat 首次生成 .env 时会自动写入一个随机值。
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# 登录/注册每 IP 每分钟允许的请求数（防暴力破解与 CPU 放大攻击）
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- 切分与检索 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
RERANK_TOP_K=3
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
MAX_HISTORY_MESSAGES=6

# ---- 请求边界（防成本/内存放大） ----
MAX_QUESTION_CHARS=2000
MAX_TOP_K=20
MAX_UPLOAD_MB=20

# ---- Router ----
# 规则判不出时是否调用 LLM 分类（默认 false：少一次 LLM 调用，直接兜底 RAG）
ROUTER_ENABLE_LLM=false

# ---- Agent ----
AGENT_MAX_ITERATIONS=5

# ============================================================
# V2 新增
# ============================================================

# ---- 文档解析扩展：Excel / CSV / OCR（扫描件） ----
# Excel(.xlsx/.xlsm) 与 CSV 开箱即用（依赖 openpyxl，已列入 requirements）。
# 扫描件与图片需要开启 ENABLE_OCR，并安装可选依赖：
#   pip install pymupdf rapidocr-onnxruntime
# （pymupdf 用于把 PDF 页面渲染成图片；rapidocr 为本地 OCR 引擎）
# 未安装时不会影响普通文本 PDF 解析，只在真正遇到扫描件/图片时报清晰错误。
ENABLE_OCR=false
# fake（离线测试用）| rapidocr（需 pip install rapidocr-onnxruntime）| none
OCR_PROVIDER=fake
OCR_LANG=ch
# PDF 抽出的文本短于该长度时，视为扫描件并尝试 OCR
OCR_MIN_CHARS=20

# ---- 流式输出（SSE） ----
ENABLE_STREAM=true
STREAM_TIMEOUT_S=180

# ---- 检索相似度阈值 ----
# 0 表示不启用（保持 V1 行为）；调高会过滤低分片段，可能把"拒答"从模型侧提前到检索侧
MIN_SCORE=0.0

# ---- 限流后端 ----
# memory（进程内，单副本）| redis（跨副本共享；Redis 不可用时自动回退 memory）
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 多租户与 RBAC ----
# 未显式指定租户时的归属（单租户部署保持 default 即可）
DEFAULT_TENANT=default
# 是否允许自助注册（关闭后只能由管理员创建用户）
ALLOW_SELF_REGISTER=true
# 该用户名首次注册时自动成为所在租户的管理员（留空则不设）
BOOTSTRAP_ADMIN_USERNAME=

# ---- MCP server（把知识库暴露给支持 MCP 的客户端） ----
ENABLE_MCP=true
MCP_SERVER_NAME=smart-kb-agent
