# LLM（OpenAI 兼容，默认 DeepSeek V4 Flash）
LLM_PROVIDER=openai
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=1024

# Embedding：本地 sentence-transformers（默认）
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量库：chroma | memory
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=data/chroma_db

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_kb

# 鉴权
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# 检索与切分
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
RERANK_TOP_K=3
ENABLE_RERANK=false
MAX_HISTORY_MESSAGES=6

# Agent
AGENT_MAX_ITERATIONS=5